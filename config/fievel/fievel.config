# Press F3 to enter mouse mode; press again to leave.
mode = "toggle"

# Show an indicator while mouse mode is active.
notify = true
home_end_enabled = true

[speeds]
normal = 300
slow = 100
fast = 900
scroll = 6
scroll_slow = 1.5
scroll_fast = 24

[easing]
movement = 0.2
scroll = 0.3

[keys]
free_mouse = "f3"
toggle_hold = "z"

left = "h"
down = "j"
up = "k"
right = "l"

left_click = "space"
right_click = "i"

scroll_left = "n"
scroll_down = "m"
scroll_up = ","
scroll_right = "."

slow = "a"
fast = "s"
locate = "q"

[keycast]
enabled = false

[hints]
label_symbols = "abcdefghijklmnopqrstuvwxyz"
border_color = "#c4a7e7e0"
fill_color = "#c4a7e718"
readability_color = "#232136e6"
label_color = "#e0def4ff"
label_highlight_color = "#f6c177ff"

[hints.keys]
left = "leftmeta + space"
right = "leftmeta + i"
cancel = "enter"
toggle_background = "leftctrl"
debug = "f8"
