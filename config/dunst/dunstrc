[global]
    monitor = 0
    follow = mouse
    origin = top-center
    offset = (0, 10)
    width = (0, 400)
    height = (0, 300)
    notification_limit = 20
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    gap_size = 0
    padding = 8
    horizontal_padding = 8
    text_icon_padding = 0
    frame_width = 4
    frame_color = "#907aa9"
    separator_color = frame
    sort = yes
    idle_threshold = 0
    layer = overlay
    font = Maple Mono NF CN 10
    line_height = 0
    format = "<b>%s</b>\n%b"
    markup = full
    alignment = center
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    enable_recursive_icon_lookup = true
    icon_theme = Papirus
    icon_position = left
    min_icon_size = 32
    max_icon_size = 128
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/firefox -new-tab
    always_run_script = true
    corner_radius = 14
    corners = all
    ignore_dbusclose = false
    enable_posix_regex = true
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = false

[urgency_low]
    background = "#faf4ed"
    foreground = "#575279"
    timeout = 10

[urgency_normal]
    background = "#faf4ed"
    foreground = "#575279"
    timeout = 10

[urgency_critical]
    background = "#b4637a"
    foreground = "#faf4ed"
    frame_color = "#faf4ed"
    timeout = 0
